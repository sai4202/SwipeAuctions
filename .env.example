# Copy to .env and fill in real values. .env itself is gitignored.

SUPABASE_DB_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

MAIL_USERNAME=
MAIL_PASSWORD=

JWT_SECRET=

# Required — no code-level default (that account is created in every environment, so a hardcoded
# fallback would ship a real, publicly-guessable seller login). Pick a strong random value.
SWIPE_STOCK_SELLER_PASSWORD=

# Optional — defaults live in application.yml
# JWT_EXPIRATION=86400000
# ADMIN_JWT_EXPIRATION=300000
# APP_FRONTEND_URL=http://localhost:3000
# Browser origins allowed to call this API, comma-separated — in production, the deployed
# frontend's actual origin (e.g. https://swipe-auctions.vercel.app), NOT the wildcard "*".
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# UPLOAD_DIR=uploads
# AUTH_MAX_ACTIVE_SESSIONS=2
# DISPUTE_PROCEEDS_HOLD_HOURS=48
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RazorpayX virtual account — only needed for seller withdrawals (a separate product from
# standard Payments); everything else works fine without it.
# RAZORPAY_ACCOUNT_NUMBER=
