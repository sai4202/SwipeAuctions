<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.swipeauctions</groupId>
    <artifactId>swipeauctions-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>SwipeAuctions Parent</name>
    <description>Modular monolith parent for the SwipeAuctions auction platform</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>swipeauctions-common</module>
        <module>swipeauctions-identity</module>
        <module>swipeauctions-catalog</module>
        <module>swipeauctions-auction</module>
        <module>swipeauctions-wallet</module>
        <module>swipeauctions-bidding</module>
        <module>swipeauctions-payment</module>
        <module>swipeauctions-dispute</module>
        <module>swipeauctions-notification</module>
        <module>swipeauctions-admin</module>
        <module>swipeauctions-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules, version-aligned so children depend on them without repeating versions -->
            <dependency>
                <groupId>com.swipeauctions</groupId>
                <artifactId>swipeauctions-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.swipeauctions</groupId>
                <artifactId>swipeauctions-identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.swipeauctions</groupId>
                <artifactId>swipeauctions-catalog</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.swipeauctions</groupId>
                <artifactId>swipeauctions-auction</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.swipeauctions</groupId>
                <artifactId>swipeauctions-wallet</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.swipeauctions</groupId>
                <artifactId>swipeauctions-bidding</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.swipeauctions</groupId>
                <artifactId>swipeauctions-payment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.swipeauctions</groupId>
                <artifactId>swipeauctions-dispute</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.swipeauctions</groupId>
                <artifactId>swipeauctions-notification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.swipeauctions</groupId>
                <artifactId>swipeauctions-admin</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Available to every module: Lombok (compile-time) and the test stack -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
